  "keywords": [
    "ai",
    "fleet-governance",
    "differential-testing",
    "cross-validation",
    "isa",
    "micro-instructions",
    "invariants",
    "honest-accounting",
    "dependency-autonomy",
    "zero-dependency",
    "self-verifying"
