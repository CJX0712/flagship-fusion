    "test:isa": "node src/isa-crosswalk.js",
    "test:variant": "node src/variant-closer.js",
    "verify:fleet": "node src/fleet-verify.js",
    "doctor:entrypoints": "node tools/entrypoint-doctor.js",
    "deps:npm-install": "node tools/fleet-npm-install.js",
    "build:dashboard": "node tools/build-dashboard.js",
    "fetch:fleet": "node tools/fleet-fetch.js"
